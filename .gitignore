# ── Maven ──
target/

# ── Build outputs (generated by ./build.sh) ──
build/
dist/

# ── Cloned upstream repos ──
tidesdb/

# ── vcpkg (no longer required; retained for safety) ──
.vcpkg/
vcpkg_installed/

# ── Compiled binaries ──
*.class
*.jar
*.so
*.dylib
*.dll

# Allow committed native libs under the resource tree
!src/main/resources/native/**/*.so
!src/main/resources/native/**/*.dylib
!src/main/resources/native/**/*.dll

# ── IDE / editor ──
.idea/
*.iml
.vscode/
*.swp
*~
.~*#
.DS_Store

# ── Python ──
__pycache__/
*.pyc
